# ---- Meta (Facebook + Instagram) ----
# whatsapp-ai app ki .env.local se same value copy karo
META_TOKEN=
# Ad account IDs — act_ ke saath ya bina, comma se
META_AD_ACCOUNTS=
# Vakilkaro-HR app (developers.facebook.com → App settings → Basic)
META_APP_ID=1752005389283386
META_APP_SECRET=

# ---- Lead Capture (optional) ----
# Leads ke liye alag token — leads_retrieval, pages_show_list,
# pages_read_engagement, pages_manage_ads, ads_read tick karke banao.
# Khaali chhodo to META_TOKEN hi use hoga (WhatsApp app wala token chhedna nahi padta).
META_LEADS_TOKEN=
# Page access token(s) — system user ko Page assign na ho tab bhi leads aa jaati hain.
# Format: pageId:token  (kai pages ho to comma se). Sirf token bhi chalega.
META_PAGE_TOKENS=

